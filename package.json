{
  "name": "gitgood",
  "version": "0.3.2",
  "description": "A GitHub Desktop-style Git client for Windows, macOS and Linux that drives the git and gh CLIs",
  "main": "./out/main/index.js",
  "author": "Erwin Wee",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "homepage": "https://github.com/erwin-wee/gitgood",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:server && npm run build:mcp",
    "build:server": "vite build --config vite.server.config.ts",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "start:server": "node out/server/index.mjs",
    "start:mcp": "node out/mcp/index.mjs",
    "install:service": "node scripts/install-service.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:fixture": "vitest run --project fixture",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "eslint . && npm run typecheck",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:tag": "node scripts/release.mjs tag"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "electron-updater": "6.8.9",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
